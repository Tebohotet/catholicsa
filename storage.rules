rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Church photos/videos live at churches/{parishId}/{churchId}/media/{fileName}
    match /churches/{parishId}/{churchId}/media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Proof-of-payment screenshots can contain bank statement details, so
    // this is deliberately NOT public read like media above - signed-in
    // only. Same defense-in-depth note applies: the real gate is that only
    // the matching Firestore order doc (buyer or parish admin) is ever
    // actually read and shown in the app.
    match /churches/{parishId}/{churchId}/proofOfPayment/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /churches/{parishId}/{churchId}/donationProof/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Step-by-step proof photos a self-couriering seller posts (packed,
    // in transit, delivered) - same sensitivity tier as the other proof
    // uploads, signed-in only rather than fully public.
    match /churches/{parishId}/{churchId}/fulfillmentProof/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Product listing photos - public read (same tier as gallery media,
    // not proof-of-payment) since anyone browsing the marketplace should
    // see them without needing to be signed in.
    match /churches/{parishId}/{churchId}/products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
