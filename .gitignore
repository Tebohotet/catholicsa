# Secrets - never commit these. A real Firebase Admin SDK key was
# committed and publicly exposed from this exact path once already
# (caught by Google's abuse scanner) - see lib/seed/seed.js for how the
# seed script now loads credentials from the environment instead.
lib/seed/serviceAccountKey.json
*serviceAccountKey*.json
.env
.env.*

# Dependency directories - these belong in package-lock.json /
# package.json, not in git. (Currently tracked in this repo - see the
# one-time cleanup instructions provided alongside this file.)
node_modules/
functions/node_modules/
firestore-tests/node_modules/
